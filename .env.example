OPENAI_API_KEY=
# Optional Reference Semantic Analyzer override: dashscope | mock | openai | gemini
# When omitted, the server uses AI_PROVIDER and available API keys, preferring DashScope when its key is configured.
ANALYZER_PROVIDER=
OPENAI_ANALYZER_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_ANALYZER_MODEL=gemini-2.5-flash
# Portrait generation. Nano Banana 2 is the default multi-image portrait model.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Protects the one-off Gemini template preview draft endpoint. Use a long random value.
TEMPLATE_ADMIN_SECRET=
# Vercel Blob stores temporary selfies and generated portraits as URLs.
BLOB_READ_WRITE_TOKEN=

# Image generation provider (existing flow)
AI_PROVIDER=dashscope
OPENAI_IMAGE_MODEL=gpt-image-1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_ANALYZER_MODEL=qwen-vl-max
DASHSCOPE_IMAGE_MODEL=wan2.7-image
# Optional generator-specific region/key. Falls back to DASHSCOPE_BASE_URL and DASHSCOPE_API_KEY.
DASHSCOPE_IMAGE_BASE_URL=
DASHSCOPE_IMAGE_API_KEY=
DASHSCOPE_IMAGE_SIZE=2K
